--                        WIND UI MAIN MENU                          --
-- ================================================================= --

local function InitializeMainUI()
    -- Reliable WindUI Loader
    local WindUI = nil
    
    local urls = {
        "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua",
        "https://tree-hub.vercel.app/api/UI/WindUI",
        "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"
    }

    for _, url in ipairs(urls) do
        local success, result = pcall(function()
            return loadstring(game:HttpGet(url))()
        end)
        if success and type(result) == "table" then
            WindUI = result
            break
        end
    end

    if not WindUI then
        warn("[PinokioScripts] Error: Could not load WindUI library.")
        return
    end

    local Window = WindUI:CreateWindow({
        Title = "PinokioScripts",
        Icon = "rbxassetid://4483345998",
        Author = "PinokioScripts",
        Folder = "PinokioScriptsConfig",
        Size = UDim2.fromOffset(580, 420),
        Transparent = true,
        Theme = "Dark" -- Valid preset theme
    })

    local MainTab = Window:Tab({ Title = "Main", Icon = "rbxassetid://4483345998" })

    MainTab:Section({ Title = "Automation" })

    -- Button to launch script without toggle
    MainTab:Button({
        Title = "Start Auto Farm",
        Desc = "Launches the cash collection script continuously",
        Callback = function()
            if ScriptRunning then return end
            ScriptRunning = true

            task.spawn(function()
                local CashFolder = Workspace:WaitForChild("Cash", 5) or Workspace:FindFirstChild("Cash")
                local Event = ReplicatedStorage:WaitForChild("CollectCash", 5) or ReplicatedStorage:FindFirstChild("CollectCash")

                if not CashFolder or not Event then
                    warn("[PinokioScripts] Cash folder or CollectCash Event not found!")
                    return
                end

                while true do
                    local cashChildren = CashFolder:GetChildren()
                    for i = 1, math.min(#cashChildren, 400) do
                        local targetCash = cashChildren[i]
                        if targetCash then
                            Event:FireServer(targetCash)
                        end
                        task.wait(0.01)
                    end
                    task.wait(0.1)
                end
            end)
        end
    })
end

-- Check if valid key already saved
if isKeyValidLocally() then
    InitializeMainUI()
    return
end

